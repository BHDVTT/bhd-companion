{{!-- Una sola raíz: cabecera y, si hay, selector de compañeros --}}
<div class="bhd-top">
<header class="bhd-header">
  {{#if character}}
  <img class="bhd-portrait" src="{{character.img}}" alt="">
  <div class="bhd-identity">
    <span class="bhd-name">{{character.name}}</span>
    <span class="bhd-player">{{#if isCompanion}}{{localize "BHD.Companion.Label"}}{{else if transformed}}{{localize "BHD.Transform.Label" name=transformed.original}}{{else}}{{userName}}{{/if}}</span>
  </div>
  {{#if transformed}}
  <button type="button" class="bhd-revert-form" data-action="bhdRevertForm" aria-label="{{localize 'BHD.Transform.Revert'}}">
    <i class="fa-solid fa-person-rays" aria-hidden="true"></i> <span>{{localize "BHD.Transform.Revert"}}</span>
  </button>
  {{/if}}
  {{else}}
  <div class="bhd-portrait bhd-portrait-empty"><i class="fa-solid fa-user" aria-hidden="true"></i></div>
  <div class="bhd-identity">
    <span class="bhd-name">{{localize "BHD.NoCharacter"}}</span>
    <span class="bhd-player">{{userName}}</span>
  </div>
  {{/if}}
  <button type="button" class="bhd-dice-fab" data-action="bhdDiceTray" aria-label="{{localize 'BHD.Dice.Title'}}">
    <i class="fa-solid fa-dice-d20" aria-hidden="true"></i>
  </button>
  <button type="button" class="bhd-exit" data-action="bhdSettings" aria-label="{{localize 'BHD.Settings.Title'}}">
    <i class="fa-solid fa-gear" aria-hidden="true"></i>
  </button>
</header>
{{!-- Personaje y compañeros (familiar, montura, invocaciones): solo si el jugador tiene alguno en la escena --}}
{{#if companions}}
<nav class="bhd-companions" aria-label="{{localize 'BHD.Companion.Choose'}}">
  {{#each companions}}
  <button type="button" class="bhd-companion {{#if active}}bhd-on{{/if}}" data-action="bhdCompanion" data-uuid="{{uuid}}"
          aria-pressed="{{active}}">
    <img src="{{img}}" alt="">
    <span class="bhd-companion-name">{{name}}</span>
    {{#if hp}}<span class="bhd-companion-hp"><i class="fa-solid fa-heart" aria-hidden="true"></i> {{hp}}</span>{{/if}}
  </button>
  {{/each}}
</nav>
{{/if}}
</div>
