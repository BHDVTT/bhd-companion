<nav class="bhd-nav tabs" data-group="primary">
  {{#each tabs as |tab|}}
  <button type="button" class="bhd-nav-btn {{tab.cssClass}}" data-action="bhdTab"
          data-group="{{tab.group}}" data-tab="{{tab.id}}" aria-pressed="{{tab.active}}">
    <i class="{{tab.icon}}" aria-hidden="true"></i>
    {{#if tab.dot}}<i class="bhd-nav-dot {{#if tab.myTurn}}bhd-my-turn{{/if}}" aria-hidden="true"></i>{{/if}}
    <span>{{localize tab.label}}</span>
  </button>
  {{/each}}
</nav>
