<main class="bhd-main">
  {{#each tabs as |tab|}}
  <section class="tab bhd-tab {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">
    {{!-- Solo se dibuja la pestaña visible (más rápido en teléfonos viejos). --}}
    {{#if tab.active}}
    {{#if (eq tab.id "character")}}
    {{> "modules/bhd-companion/templates/mobile/character.hbs" sheet=@root.sheet choices=@root.choices hpAmount=@root.hpAmount deathSaves=@root.deathSaves}}
    {{else if (eq tab.id "actions")}}
    {{> "modules/bhd-companion/templates/mobile/actions.hbs" actions=@root.actions filters=@root.actionFilters spellSearch=@root.spellSearch}}
    {{else if (eq tab.id "combat")}}
    {{> "modules/bhd-companion/templates/mobile/combat.hbs" combat=@root.combat deathSaves=@root.deathSaves}}
    {{else if (eq tab.id "move")}}
    {{> "modules/bhd-companion/templates/mobile/move.hbs" move=@root.move}}
    {{else if (eq tab.id "inventory")}}
    {{> "modules/bhd-companion/templates/mobile/inventory.hbs" inventory=@root.inventory}}
    {{else if (eq tab.id "notes")}}
    {{> "modules/bhd-companion/templates/mobile/notes.hbs" notes=@root.notes}}
    {{/if}}
    {{/if}}
  </section>
  {{/each}}
</main>
